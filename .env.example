# OpenRouter API (get from openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-xxxxx

# Supabase (project settings > API)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=eyJxxxxx

# WhatsApp groups to monitor (comma-separated group IDs)
TARGET_GROUPS=

# LLM model (free/cheap on OpenRouter)
LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Backfill: fetch missed messages on reconnect (optional)
BACKFILL_HOURS=24
BACKFILL_LIMIT=50
